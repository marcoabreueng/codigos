            checked={aceitouTermos}
            onChange={(e) => setAceitouTermos(e.target.checked)}
            style={styles.checkbox}
          />
          <label htmlFor="termosDeUso" style={styles.checkboxLabel}>
            Eu li e aceito os{" "}
            <a
              href="#"
              onClick={(e) => {
                e.preventDefault();
                setMostrarTermosModal(true);
              }}
              style={styles.termosLink}
            >
              Termos de Uso
            </a>
          </label>
        </div>
        <button type="submit" style={styles.submitButton}>
          Cadastrar
        </button>
      </form>
    </section>
  )}

  {/* Modal de Termos de Uso */}
  {mostrarTermosModal && (
    <div style={styles.modalOverlay}>
      <div style={styles.modalContent}>
        <button
          onClick={() => setMostrarTermosModal(false)}
          style={styles.modalCloseButton}
        >
          X
        </button>
        <h2 style={{ color: "#2E8B57" }}>
          Termos e Condições Gerais de Uso
        </h2>
        <div style={styles.termsScrollableArea}>{termosDeUsoContent}</div>
      </div>
    </div>
  )}
</div>
);
}

