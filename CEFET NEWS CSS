:root {
    --primary-blue: #001529;
    --text-gray: #666;
    --light-bg: #f4f7f6;
    --white: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--white);
    color: #333;
    line-height: 1.6;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header */
header {
    padding: 20px 0;
    border-bottom: 1px solid #eee;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

nav ul li a {
    text-decoration: none;
    color: #555;
    font-weight: 500;
    font-size: 14px;
}

nav ul li a.active {
    color: #000;
    border-bottom: 2px solid #000;
    padding-bottom: 5px;
}

/* Hero Section */
.hero {
    background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('hero-bg.jpg'); /* Adicione sua imagem de fundo */
    background-size: cover;
    background-position: center;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
}

.hero h1 { font-size: 3rem; margin-bottom: 10px; }

/* Grid de Notícias */
.section-title {
    margin: 40px 0 20px;
    font-size: 24px;
}

.news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
}

.news-card img {
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
}

.card-content { padding: 15px 0; }
.date { color: #aaa; font-size: 12px; }
.news-card h3 { margin: 10px 0; font-size: 18px; line-height: 1.3; }
.blue-text { color: #3b82f6; }
.news-card p { color: var(--text-gray); font-size: 14px; }

/* Seção de Contato */
.contact-section {
    background-color: var(--light-bg);
    padding: 80px 0;
}

.contact-header {
    text-align: center;
    margin-bottom: 50px;
}

.contact-header h2 { font-size: 32px; margin-bottom: 10px; }

.contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 50px;
}

.info-item {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
}

.info-item i {
    background: #e5e7eb;
    padding: 15px;
    border-radius: 8px;
    color: #333;
}

.contact-form {
    background: white;
    padding: 40px;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

.contact-form label {
    display: block;
    margin-bottom: 5px;
    font-size: 14px;
    font-weight: 600;
}

.contact-form input, .contact-form textarea {
    width: 100%;
    padding: 12px;
    margin-bottom: 20px;
    border: 1px solid #ddd;
    border-radius: 8px;
}

.contact-form button {
    width: 100%;
    background: var(--primary-blue);
    color: white;
    padding: 15px;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.contact-form button:hover {
    background: #002a52;
}

/* Responsividade */
@media (max-width: 768px) {
    .contact-wrapper { grid-template-columns: 1fr; }
    nav ul { display: none; } /* Idealmente um menu hamburguer aqui */
}
